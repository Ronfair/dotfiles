layout {
    gaps 5
    center-focused-column "never"

    focus-ring {
        active-color   "#a032e6ff"
        inactive-color "#595959aa"
        urgent-color   "#d95757"
    }

    border {
        active-color   "#e6b450"
        inactive-color "#0b0e14"
        urgent-color   "#d95757"
    }

    shadow {
        color "#00000070"
    }

    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    tab-indicator {
        active-color   "#e6b450"
        inactive-color "#7d5507"
        urgent-color   "#d95757"
    }

    insert-hint {
        color "#e6b45080"
    }
}

recent-windows {
    highlight {
        active-color "#e6b450"
        urgent-color "#d95757"
    }
}

